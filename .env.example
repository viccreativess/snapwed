# SnapWed Environment Variables
# Copy this file to .env and fill in your values

# ── Admin ──────────────────────────────────────────────────────────────────
# Password for the admin panel
ADMIN_PASSWORD=your-secret-password-here

# ── Sessions ───────────────────────────────────────────────────────────────
# Random secret string for session encryption (generate any random string)
SESSION_SECRET=change-me-to-a-random-string

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For Railway, this will be: https://your-app.railway.app/api/admin/auth/google/callback
# For local dev: http://localhost:3000/api/admin/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/auth/google/callback

# ── App ────────────────────────────────────────────────────────────────────
# Your public app URL (used for QR code generation)
# For Railway: https://your-app-name.railway.app
# For local dev: http://localhost:3000
BASE_URL=http://localhost:3000

# Port (Railway sets this automatically)
PORT=3000
